    // ---------------- 业务区（资源关共同入口） ----------------
    // 国服主界面底部没有"战斗"按钮，资源关入口都在主界面右侧的"业务区"里。
    // 业务区实际入口（2026-10 截图确认）：任务、故事、悬赏通缉、总力战、
    // 综合战术测试、大决战、特别委托、学院交流会、战术对抗赛、无限限制战。
    // 当前接入：特别委托 / 悬赏通缉 / 战术对抗赛（每日）；
    // 总力战 / 大决战（周常 raid）与学院交流会可按同样的"入口→选择关卡→扫荡"模式扩展。
    // 结构：主流程 → 业务区_进入 → 业务区_调度（小环依次尝试各入口）→ 业务区_返回 → 主流程
    //
    // 防重复进入的推荐做法：入口图标截图时带上每日剩余次数角标（如 1/1），
    // 当日完成后角标变为 0/1，模板自然不再命中；若实际 UI 无状态差异，
    // 接入时需观察"已完成"的表现（弹提示/置灰），必要时改用 agent 计数。
    "业务区_进入": {
        "recognition": "TemplateMatch",
        "template": "placeholder.png",
        "enabled": false,
        "action": "Click",
        "post_delay": 2500,
        "next": [
            "业务区_调度"
        ]
    },
    "业务区_调度": {
