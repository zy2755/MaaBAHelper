{
    // ============================================================
    // 通用弹窗处理
    // BA 流程中会随机弹出奖励结算、升级提示、公告等弹窗，
    // 各任务链在关键步骤后引用这些节点兜底。
    // roi 以 1280x720 为基准，坐标为 [x, y, w, h]，接入后请按实测调整。
    // ============================================================
    // 弹窗队列清除：登录后 通知/沙勒新闻/签到簿 等弹窗排队出现且无底部按钮。
    // 链路：标题命中 → 勾"今日不再显示"（沙勒新闻有，勾了才不会反复弹）→ 按安卓返回键。
    // 注意：不可自引用 next（2026-10-29 实测会连环报 invalid node id），
    // 队列清空靠每日链的 JumpBack 重评估和 agent 循环多次调用。
    "通用_弹窗返回键": {
        "recognition": "OCR",
        "expected": ["沙勒新闻", "通知", "签到"],
        "roi": [140, 75, 900, 90],
        "timeout": 1500,
        "action": "DoNothing",
        "next": [
            "通用_弹窗_今日不再显示",
            "通用_弹窗_签到簿",
            "通用_弹窗_按返回键"
        ]
    },
    "通用_弹窗_今日不再显示": {
        "recognition": "OCR",
        "expected": ["今日不再显示"],
        "roi": [950, 600, 220, 70],
        "timeout": 1000,
        "action": "Click",
        "target": true,
        "target_offset": [-42, -1, -71, 2],
        "post_delay": 600,
        "next": ["通用_弹窗_按返回键"]
    },
    // 签到簿是全屏页且无视返回键、无关闭钮（2026-10-29 实测）：
    // 点"今日"格子（第5天位置恒已签）→ 未签则签、已签则 toast 后关板
    "通用_弹窗_签到簿": {
        "recognition": "OCR",
        "expected": ["签到簿"],
        "roi": [700, 90, 400, 80],
        "timeout": 800,
        "action": "Click",
        "target": [1150, 270],
        "post_delay": 1500,
        "next": []
    },
    "通用_弹窗_按返回键": {
        "recognition": "DirectHit",
        "action": "ClickKey",
        "key": 4,
        "post_delay": 1200,
        "next": []
    },
    // 主界面闲置息屏唤醒：BA 主界面闲置后 UI 全部淡出（只剩看板/人物），
    // 点一下顶部空白即恢复（用户实测确认）。任务链启动时若 UI 隐藏，
    // 邮件红点/导航按钮等识别全部落空——链头先无条件点一下。
    "通用_唤醒屏幕": {
        "recognition": "DirectHit",
        "target": [600, 80, 80, 40],
        "action": "Click",
        "post_delay": 1000,
        "next": []
    },
    "通用_确认": {
        "recognition": "OCR",
        "expected": ["确认", "确 认", "好的"],
        // 弹窗按钮通常出现在屏幕下方中央区域
        "roi": [400, 520, 480, 180],
        "action": "Click",
        "post_delay": 800,
        // 兜底跳回调度环：链中间处理完弹窗后由 "每日_主流程" 重新调度
        "next": [
            "通用_确认",
            "通用_关闭",
            "每日_主流程"
        ]
    },
    "通用_关闭": {
        "recognition": "OCR",
        "expected": ["关闭", "取消"],
        "roi": [400, 520, 480, 180],
        "action": "Click",
        "post_delay": 800,
        "next": [
            "通用_关闭",
            "每日_主流程"
        ]
    },
    // 开机角色动画的"跳过"按钮（右上角）。已挂到 每日_主流程 的 JumpBack 兜底：
    // 动画期间主流程其他节点均不命中，仅本节点命中并点击跳过
    "通用_跳过动画": {
        "recognition": "OCR",
        "expected": ["跳过", "SKIP"],
        "roi": [980, 0, 300, 120],
        "action": "Click",
        "post_delay": 1500,
        "next": [
            "通用_跳过动画",
            "每日_主流程"
        ]
    },
    // 左上/右上的返回箭头按钮没有文字，需要截图：
    // 1. 用 VSCode 插件 Maa Pipeline Support 或 ImageCropper 从 720p 截图中裁剪
    // 2. 保存为 assets/resource/image/common/return_arrow.png
    // 3. 将下方 template 的 placeholder.png 替换为 common/return_arrow.png，并删除 "enabled": false
    "通用_返回上一页": {
        "recognition": "TemplateMatch",
        "template": "placeholder.png",
        "target": [55, 33, 30, 30],
        "enabled": false,
        "action": "Click",
        "post_delay": 1500,
        "next": [
            "通用_返回上一页"
        ]
    }
}
