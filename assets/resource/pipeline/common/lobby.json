{
    // ============================================================
    // 主界面（Lobby）判定与导航
    // 国服主界面：左上角"等级 + 数字"；底部图标按钮一排：
    // 咖啡厅 / 日程 / 成员 / 编队 / 社交 / 制造 / 商店 / 招募；
    // 右侧中部有"业务区"入口（特别委托 / 悬赏 / 战术对抗赛在业务区内）。
    // 图标基本无文字，必须用模板匹配。所有按钮截图前均为占位（enabled: false）。
    //
    // 截图接入流程（以 VSCode 插件 Maa Pipeline Support 为例）：
    //   1. 模拟器分辨率设为 1280x720，游戏停在主界面
    //   2. 用插件截图，直接在截图上框选按钮裁剪，保存到 assets/resource/image/lobby/ 下：
    //      btn_cafe.png（咖啡厅）/ btn_schedule.png（日程）/ btn_store.png（商店）
    //      / btn_business.png（业务区）/ btn_mail.png（邮箱，右上角信封）
    //   3. 将节点 template 的 placeholder.png 替换为保存的路径（如 lobby/btn_cafe.png），
    //      并删除 "enabled": false
    // ============================================================

    // 主界面判定：左上角"等级"二字。注意 roi 不能圈到右边"活动进行中！等级奖励"横幅，
    // 那里也有"等级"字样；日服/国际服若显示为 Lv，可把 expected 改为数组加入 "Lv"
    "主界面_判定": {
        "recognition": "OCR",
        "expected": "等级",
        "roi": [0, 0, 130, 100],
        "timeout": 2500,
        "action": "DoNothing",
        "next": []
    },

    // 底栏导航按钮：国服底栏图标下方带文字标签（咖啡厅/日程/…/商店/招募），
    // 全部用 OCR 识别，无需截图模板。roi 圈住整个底栏文字区域
    // 咖啡厅底栏按钮的红点角标（RGB 254,77,34）：有红点=咖啡厅有待领取内容，
    // 领完后红点消失不再命中，防止任务环反复进出咖啡厅；
    // 识别命中红点后通过 target 点击按钮本体
    "主界面_进入咖啡厅": {
        "recognition": "ColorMatch",
        "roi": [116, 666, 20, 22],
        "lower": [200, 40, 0],
        "upper": [255, 140, 100],
        "connected": true,
        "action": "Click",
        "target": [65, 628, 60, 44],
        "post_delay": 2500,
        "next": [
            "咖啡厅_领取信用点",
            "咖啡厅_返回主界面"
        ]
    },

    "主界面_进入商店": {
        "recognition": "OCR",
        "expected": "商店",
        "roi": [0, 640, 1280, 80],
        "action": "Click",
        "post_delay": 2500,
        "next": [
            "商店_每日购买"
        ]
    },

    // 主界面右侧中部的"业务区"大按钮（正在进行中！业务区）。
    // 按钮上有"业务区"文字，直接用 OCR 识别，无需截图模板；
    // roi 圈住主界面右侧按钮区域，避免误识别其他页面的"业务区"标题
    "主界面_进入业务区": {
        "recognition": "OCR",
        "expected": "业务区",
        "roi": [1040, 570, 240, 150],
        "action": "Click",
        "post_delay": 2500,
        "next": []
    }
}

