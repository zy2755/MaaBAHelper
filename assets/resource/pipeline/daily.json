{
    // ============================================================
    // 每日任务环（调度节点）
    //
    // 工作原理：MaaFramework 会并行匹配 next 列表中的所有节点，
    // 执行命中的那条链；每条链走完后回到 "每日_主流程"，如此循环，
    // 直到 next 中所有节点都不再可匹配（即所有日常都已完成）。
    //
    // 新增日常时：写好子链，把入口节点加进 next 列表即可。
    // 占位节点（enabled: false）不会被匹配，等效于"该任务未启用"。
    // ============================================================
    "每日_主流程": {
        "next": [
            // JumpBack 兜底：每轮调度优先检查随机弹窗和开机动画，命中则处理并跳回本节点重新识别
            "[JumpBack]通用_确认",
            "[JumpBack]通用_关闭",
            "[JumpBack]通用_跳过动画",
            "邮件_领取",
            "主界面_进入咖啡厅",
            "主界面_进入商店",
            "日程_主流程",
            "业务区_进入"
        ]
    },

    // ---------------- 任务入口（供 interface.json 单独引用） ----------------
    "咖啡厅_主流程": {
        "next": [
            "[JumpBack]通用_确认",
            "[JumpBack]通用_关闭",
            "[JumpBack]通用_跳过动画",
            "主界面_进入咖啡厅"
        ]
    },
    "商店_主流程": {
