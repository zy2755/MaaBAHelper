        "recognition": "ColorMatch",
        "roi": [1172, 8, 20, 20],
        "lower": [200, 40, 0],
        "upper": [255, 140, 100],
        "connected": true,
        "action": "Click",
        "target": [1108, 22, 58, 44],
        "post_delay": 2000,
        "next": [
            "邮件_一键领取"
        ]
    },
