{
    // 本文件定义了通用 UI（MFAAvalonia 等）的行为和显示内容
    // 协议文档：https://maafw.com/docs/3.3-ProjectInterfaceV2
    "interface_version": 2,
    "name": "MaaBAHelper",
    "description": "基于 MaaFramework 的蔚蓝档案（Blue Archive）每日/活动自动化助手。",
    "version": "0.1.0",
    "license": "MIT",
    "contact": "TODO: 建好仓库后填写 issues 地址 / QQ 群",
    // 填写项目地址和版本号可实现通用 UI 的自动更新功能
    "github": "TODO: 创建仓库后替换为你的仓库地址",
    "controller": [
        {
            "name": "安卓模拟器",
            "type": "Adb",
            // 蔚蓝档案为 16:9 横屏游戏，模拟器分辨率请设为 1280x720 或 1920x1080
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "国服-官服",
            "path": [
                "./resource"
            ]
        },
        {
            "name": "国服-B服",
            "path": [
                "./resource"
                // B 服 UI 与官服基本一致，若有差异可新建 ./resource/bilibili 覆盖：
                // "./resource/bilibili"
            ]
        }
        // 如需支持国际服 / 日服 / 繁中服，需在 MaaCommonAssets 中取对应语言的 OCR 模型，
        // 新建 resource 覆盖目录，并在上方追加 resource 条目
    ],
    // agent 为 Python 自定义识别/动作进程（agent/main.py），本机需 pip install MaaFw
    "agent": {
        "child_exec": "python",
        "child_args": [
            "./agent/main.py"
        ]
    },
    "task": [
        {
            // 调试用：OCR 识别主界面左上角"等级"二字，不需要任何截图素材，
            // 用于验证 模拟器连接→截图→OCR→pipeline 全链路是否正常
            "name": "环境自检（OCR 连通性测试）",
            "entry": "主界面_判定"
        },
        {
            "name": "每日清理（一键日常）",
            "entry": "每日_主流程"
        },
        {
            "name": "咖啡厅",
            "entry": "咖啡厅_主流程"
        },
        {
            "name": "商店",
            "entry": "商店_主流程",
            "option": [
                "商店购买品类"
            ]
        },
        {
            "name": "日程清券",
            "entry": "日程_主流程"
        },
        {
            // 单跑战术对抗赛：进业务区后跳过小环，直达 PvP 入口
            "name": "悬赏通缉",
            "entry": "悬赏_主流程",
            "option": ["悬赏_委托地点", "悬赏_目标关卡", "刷取次数"]
        },
        {
            "name": "学院交流会",
            "entry": "学院_主流程",
            "option": ["学院_选择学院", "学院_目标关卡", "刷取次数"]
        },
        {
            // 单跑战术对抗赛：进业务区后跳过小环，直达 PvP 入口
            "name": "战术对抗赛",
            "entry": "业务区_进入",
            "pipeline_override": {
                "业务区_进入": {
                    "next": [
                        "战术对抗赛_入口"
                    ]
                }
            }
        },
        // —— 调试预设：对应节点截图接入一个，就能单独跑通一个 ——
        {
            "name": "调试·打开邮箱",
            "entry": "邮件_领取"
        },
        {
            "name": "调试·进入业务区",
            "entry": "主界面_进入业务区"
        }
    ],
    "option": {
        "悬赏_委托地点": {
            "type": "select",
            "cases": [
                { "name": "高架公路", "pipeline_override": { "悬赏_模式_高架公路": { "enabled": true } } },
                { "name": "沙漠铁路", "pipeline_override": { "悬赏_模式_沙漠铁路": { "enabled": true } } },
                { "name": "讲堂", "pipeline_override": { "悬赏_模式_讲堂": { "enabled": true } } }
            ]
        },
        "悬赏_目标关卡": {
            "type": "checkbox",
            "cases": [
                { "name": "第1关", "pipeline_override": { "悬赏_总控": { "custom_action_param": { "level_enabled": { "1": true } } } } },
                { "name": "第2关", "pipeline_override": { "悬赏_总控": { "custom_action_param": { "level_enabled": { "2": true } } } } },
                { "name": "第3关", "pipeline_override": { "悬赏_总控": { "custom_action_param": { "level_enabled": { "3": true } } } } },
                { "name": "第4关", "pipeline_override": { "悬赏_总控": { "custom_action_param": { "level_enabled": { "4": true } } } } },
                { "name": "第5关", "pipeline_override": { "悬赏_总控": { "custom_action_param": { "level_enabled": { "5": true } } } } },
                { "name": "第6关", "pipeline_override": { "悬赏_总控": { "custom_action_param": { "level_enabled": { "6": true } } } } },
                { "name": "第7关", "pipeline_override": { "悬赏_总控": { "custom_action_param": { "level_enabled": { "7": true } } } } },
                { "name": "第8关", "pipeline_override": { "悬赏_总控": { "custom_action_param": { "level_enabled": { "8": true } } } } },
                { "name": "第9关", "pipeline_override": { "悬赏_总控": { "custom_action_param": { "level_enabled": { "9": true } } } } },
                { "name": "第10关", "pipeline_override": { "悬赏_总控": { "custom_action_param": { "level_enabled": { "10": true } } } } }
            ]
        },
        // 全刷 = 入场后先点任务信息面板的"最大值"，再开始快速战斗（一次用尽剩余挑战券）
        "刷取次数": {
            "type": "select",
            "cases": [
                { "name": "刷一次", "pipeline_override": { "悬赏_快战_最大值": { "enabled": false }, "学院_快战_最大值": { "enabled": false } } },
                { "name": "全刷", "pipeline_override": { "悬赏_快战_最大值": { "enabled": true }, "学院_快战_最大值": { "enabled": true } } }
            ]
        },
        "学院_选择学院": {
            "type": "select",
            "cases": [
                { "name": "崔尼蒂", "pipeline_override": { "学院_模式_崔尼蒂": { "enabled": true } } },
                { "name": "歌赫娜", "pipeline_override": { "学院_模式_歌赫娜": { "enabled": true } } },
                { "name": "千禧年", "pipeline_override": { "学院_模式_千禧年": { "enabled": true } } }
            ]
        },
        "学院_目标关卡": {
            "type": "checkbox",
            "cases": [
                { "name": "第1关", "pipeline_override": { "学院_总控": { "custom_action_param": { "level_enabled": { "1": true } } } } },
                { "name": "第2关", "pipeline_override": { "学院_总控": { "custom_action_param": { "level_enabled": { "2": true } } } } },
                { "name": "第3关", "pipeline_override": { "学院_总控": { "custom_action_param": { "level_enabled": { "3": true } } } } },
                { "name": "第4关", "pipeline_override": { "学院_总控": { "custom_action_param": { "level_enabled": { "4": true } } } } }
            ]
        },
        // 多选：勾选哪些品类，商店筛选时就勾选哪些类型复选框；
        // 全不勾 = 不筛选，保持商店默认显示
        "商店购买品类": {
            "type": "checkbox",
            "cases": [
                {
                    "name": "活动报告书",
                    "pipeline_override": {
                        "商店_筛选_活动报告书": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "装备",
                    "pipeline_override": {
                        "商店_筛选_装备": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "神秘古物",
                    "pipeline_override": {
                        "商店_筛选_神秘古物": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "组合商品",
                    "pipeline_override": {
                        "商店_筛选_组合商品": {
                            "enabled": true
                        },
                        "商店_点击全选": {
                            "enabled": true
                        },
                        "商店_点击购买": {
                            "enabled": true
                        }
                    }
                }
            ]
        }
    }
}
